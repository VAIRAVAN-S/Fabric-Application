# The default provider is fully local and requires no API key.
AI_PROVIDER=local

# Set AI_PROVIDER=openai to use semantic embeddings from OpenAI instead.
# OPENAI_API_KEY=replace_with_your_key
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cross-catalog duplicate threshold. Raise it to reduce false positives.
MATCH_THRESHOLD=0.74
